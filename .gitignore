# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Editor / tool-local config (contains machine-specific interpreter paths)
.claude/

# Generated output.
#
# out/ is written by `python -m razorpay_fraud demo`, so almost all of it is
# reproducible and stays untracked. The exceptions below are tracked on
# purpose: the README links to them, and someone reading the repo on GitHub
# should see the results and the charts without having to run anything first.
out/*
!out/RESULTS.md
!out/report.json
!out/seed_sweep.json
!out/timeline.png
!out/pr_curves.png
!out/cost_curve.png
!out/detection_latency.png

# Large or derived files that add nothing to a diff:
#   alerts.jsonl        312K audit trail, regenerated by `demo`
#   dashboard_data.json 528K bundle, derived from report.json
#   console.html        the published artifact, built from dashboard_data.json
#   *.log               run logs
